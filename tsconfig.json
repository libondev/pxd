{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "baseUrl": "./",
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "#/*": ["./src/*"],
      "#types": ["./src/types"],
      "#types/*": ["./src/types/*"],
      "#utils/*": ["./src/components/_utils/*"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "shims/**.d.ts", "src/types/**/*.d.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
