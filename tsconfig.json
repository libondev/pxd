{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "baseUrl": "./",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": ["./src/*"],
      "#types": ["./src/types"],
      "#types/*": ["./src/types/*"],
      "#utils/*": ["./src/components/_utils/*"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": [
    "shims/**/*.d.ts",
    "src/**/*.{ts,tsx,vue}",
    "docs/**/*.{ts,tsx,vue}"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
