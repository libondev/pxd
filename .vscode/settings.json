{
  "css.customData": [
    ".vscode/tailwind.json"
  ],
  "javascript.preferences.importModuleSpecifierEnding": "index",
  "typescript.preferences.importModuleSpecifierEnding": "index",
  // Disable the default formatter, use eslint instead
  "eslint.enable": false,
  "prettier.enable": false,
  // Auto fix
  "oxc.typeAware": true,
  "oxc.configPath": "oxlintrc.json",
  "oxc.unusedDisableDirectives": "deny",
  "oxc.fmt.configPath": "oxfmtrc.jsonc",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file", // oxfmt can only format whole files
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass"
  ],
  "tailwindCSS.classFunctions": [
    "cn",
    "tv",
    "clsx",
    "twMerge"
  ],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  // Enable eslint for all supported languages
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc"
  ],
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "build.config.*": "jsconfig*, vitest.*, eslint.config.*, cypress.config.*, playwright.config.*",
    "package.json": "package-lock.json, pnpm*, .npmrc, .yarnrc*, yarn*, .oxlint*, oxlint*, .prettier*, prettier*, .editorconfig"
  },
  "cSpell.words": [
    "antfu",
    "autospace",
    "backtop",
    "bumpp",
    "choicebox",
    "Cmdk",
    "esno",
    "gdsi",
    "gdsicon",
    "grayscale",
    "kabab",
    "libondev",
    "mkdist",
    "nowrap",
    "numberish",
    "nums",
    "pascalize",
    "predev",
    "pxd",
    "rgba",
    "rolldown",
    "rspack",
    "shiki",
    "shikijs",
    "tsup",
    "turborepo",
    "uncapitalize",
    "unref",
    "vite",
    "vitesse",
    "vitest",
    "rsbuild"
  ]
}
