{
  "name": "pxd",
  "type": "module",
  "version": "0.0.52",
  "packageManager": "pnpm@9.15.9",
  "description": "A universal UI component library for Vue2.7+ & Vue3.2+",
  "author": "libondev <bon.li@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/libondev/pxd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libondev/pxd.git"
  },
  "bugs": {
    "url": "https://github.com/libondev/pxd/issues"
  },
  "keywords": [
    "ui",
    "vue",
    "pxd",
    "vue2",
    "vue3",
    "components",
    "ui framework",
    "component library"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/plugins/resolver.d.ts",
      "default": "./dist/plugins/resolver.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "default": "./dist/composables/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "default": "./dist/locales/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./volar": "./volar.d.ts",
    "./tw.css": "./dist/styles/tw.css",
    "./styles.css": "./dist/styles/styles.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.vue.ts",
      "default": "./dist/components/*/index.vue"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "default": "./dist/composables/*.js"
    },
    "./contexts/*": {
      "types": "./dist/contexts/*.d.ts",
      "default": "./dist/contexts/*.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    },
    "./types/*": "./dist/types/*.d.ts",
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles/index.css",
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "dist/*",
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "volar.d.ts"
  ],
  "scripts": {
    "dev": "run-s dev:lib dev:docs",
    "dev:lib": "unbuild --stub",
    "dev:docs": "pnpm --filter docs dev",
    "build": "run-s update-exports build:core build:docs",
    "build:lib": "run-s gen-volar-dts update-exports build:core build:style",
    "build:core": "mkdist -d --src=src --ext=js --format=esm",
    "build:only": "run-s build:core build:docs",
    "build:docs": "pnpm --filter docs build",
    "build:style": "run-s gen-styles-file gen-tw-css-file",
    "update-exports": "node scripts/update-exports.js",
    "gen-styles-file": "node scripts/gen-css-files.js",
    "gen-tw-css-file": "tailwindcss -i ./dist/styles/source.css -o ./dist/styles/styles.css -m",
    "gen-volar-dts": "node scripts/gen-component-dts.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "bump": "pnpx bumpp",
    "prepare": "husky",
    "postversion": "run-s gen-volar-dts update-exports",
    "prepublishOnly": "run-s build:lib"
  },
  "peerDependencies": {
    "vue": ">=2.7.0 || >=3.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:default",
    "@gdsicon/vue": "catalog:default",
    "dayjs": "catalog:default",
    "es-toolkit": "catalog:default",
    "focus-trap": "catalog:default",
    "tailwind-variants": "catalog:default"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:default",
    "@tailwindcss/cli": "catalog:default",
    "@tsconfig/node22": "catalog:default",
    "@types/node": "catalog:default",
    "@vitejs/plugin-vue": "catalog:default",
    "@vue/test-utils": "catalog:default",
    "@vue/tsconfig": "catalog:default",
    "eslint": "catalog:default",
    "eslint-plugin-better-tailwindcss": "catalog:default",
    "fs-extra": "catalog:default",
    "happy-dom": "catalog:default",
    "husky": "catalog:default",
    "lint-staged": "catalog:default",
    "mkdist": "catalog:default",
    "npm-run-all2": "catalog:default",
    "tinyglobby": "catalog:default",
    "typescript": "catalog:default",
    "unbuild": "catalog:default",
    "unplugin-vue-components": "catalog:default",
    "vitest": "catalog:default",
    "vue": "catalog:default",
    "vue-sfc-transformer": "catalog:default",
    "vue-tsc": "catalog:default"
  },
  "pnpm": {
    "patchedDependencies": {
      "mkdist": "patches/mkdist.patch"
    }
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix"
  }
}
