{
  "name": "pxd",
  "version": "0.1.2",
  "description": "A universal Vue 2.7 & 3.2 component library built from one codebase. Built-in light/dark theme. PC & mobile ready. Animation-free mode supported.",
  "keywords": [
    "component-library",
    "dark-mode",
    "design-system",
    "responsive",
    "tailwind",
    "typescript",
    "ui",
    "vue",
    "vue-components",
    "vue2",
    "vue3"
  ],
  "homepage": "https://github.com/libondev/pxd#readme",
  "bugs": {
    "url": "https://github.com/libondev/pxd/issues"
  },
  "license": "MIT",
  "author": "libondev <bon.li@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libondev/pxd.git"
  },
  "style": "./dist/styles/styles.css",
  "files": [
    "dist",
    "volar.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/plugins/resolver.d.ts",
      "default": "./dist/plugins/resolver.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "default": "./dist/composables/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "default": "./dist/locales/index.js"
    },
    "./volar": "./volar.d.ts",
    "./tw.css": "./dist/styles/tw.css",
    "./styles.css": "./dist/styles/styles.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.vue.ts",
      "default": "./dist/components/*/index.vue"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "default": "./dist/composables/*.js"
    },
    "./contexts/*": {
      "types": "./dist/contexts/*.d.ts",
      "default": "./dist/contexts/*.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    },
    "./types/*": "./dist/types/*/index.d.ts",
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "dev": "run-s dev:lib dev:docs",
    "dev:lib": "unbuild --stub",
    "dev:docs": "pnpm --filter docs dev",
    "build": "run-s build:lib build:docs",
    "build:lib": "run-s update-exports build:core build:style",
    "build:only": "run-s build:core build:docs",
    "build:core": "node scripts/build-core.js",
    "build:style": "node scripts/gen-css-files.js",
    "build:docs": "pnpm --filter docs build",
    "update-exports": "node scripts/update-exports.js",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:eol": "node scripts/fmt-eol.js",
    "check:fmt": "vp fmt --check",
    "check:type": "vp run typecheck",
    "check:suffix": "node scripts/ensure-js-suffix.js --check",
    "test": "vp test run",
    "test:watch": "vp test",
    "preview": "pnpm --filter docs preview",
    "bump": "pnpx bumpp",
    "postversion": "pnpm update-exports",
    "prepublishOnly": "pnpm build:lib"
  },
  "dependencies": {
    "@chenglou/pretext": "catalog:default",
    "@floating-ui/dom": "catalog:default",
    "@gdsicon/vue": "catalog:default",
    "@tanstack/virtual-core": "catalog:default",
    "cn": "catalog:default",
    "dayjs": "catalog:default",
    "focus-trap": "catalog:default"
  },
  "devDependencies": {
    "@tailwindcss/cli": "catalog:default",
    "@tsconfig/node22": "catalog:default",
    "@types/node": "catalog:default",
    "@vitejs/plugin-vue": "catalog:default",
    "@vue/test-utils": "catalog:default",
    "@vue/tsconfig": "catalog:default",
    "eslint-plugin-better-tailwindcss": "catalog:default",
    "happy-dom": "catalog:default",
    "mkdist": "catalog:default",
    "npm-run-all2": "catalog:default",
    "tslib": "catalog:default",
    "typescript": "catalog:default",
    "unbuild": "catalog:default",
    "unplugin-vue-components": "catalog:default",
    "vite-plus": "catalog:",
    "vue": "catalog:default",
    "vue-router": "catalog:default",
    "vue-sfc-transformer": "catalog:default",
    "vue-tsc": "catalog:default"
  },
  "peerDependencies": {
    "vue": ">=2.7.0 <3.0.0 || >=3.2.0",
    "vue-router": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "patchedDependencies": {
      "mkdist": "patches/mkdist.patch"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
