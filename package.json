{
  "name": "pxd",
  "type": "module",
  "version": "0.0.6",
  "description": "A universal UI component library for Vue2&3.",
  "author": "libondev <bon.li@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/libondev/pxd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libondev/pxd.git"
  },
  "bugs": {
    "url": "https://github.com/libondev/pxd/issues"
  },
  "keywords": [
    "ui",
    "vue",
    "ui framework",
    "component library"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/plugins/nuxt.d.ts",
      "default": "./dist/plugins/nuxt.js"
    },
    "./resolver": {
      "types": "./dist/plugins/resolver.d.ts",
      "default": "./dist/plugins/resolver.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components/*": "./dist/components/*/index.vue"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/tokens.css",
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "dist/*",
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "predev": "unbuild --stub",
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter docs dev",
    "dev:vue2": "pnpm predev && pnpm --filter vue2 dev",
    "prebuild": "node scripts/update-exports.js && unbuild",
    "build": "pnpm build:docs",
    "build:docs": "pnpm prebuild && pnpm --filter docs build",
    "build:vue2": "pnpm prebuild && pnpm --filter vue2 build",
    "preview": "pnpm --filter docs preview",
    "preview:vue2": "pnpm --filter vue2 preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@testing-library/vue": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "mkdist": "catalog:",
    "tailwindcss": "catalog:",
    "tinyglobby": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
